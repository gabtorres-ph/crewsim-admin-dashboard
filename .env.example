# Test deployments only: Vite embeds these values in the browser bundle.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CORE_API_URL=http://localhost:8000
VITE_USE_MOCK_API=false
# Nixpacks static builds must use the public Cloudflare-protected API URL.
VITE_API_BASE_URL=https://api.example.com/api
NIXPACKS_NODE_VERSION=24
